{
  "debug": false,
  "historySize": 0,
  // true면 툴 루프의 매 LLM 호출마다 분류기를 다시 실행해 tier를 재결정함.
  // 분류기 입력에 이번 턴의 최신 assistant/tool 진행상황이 포함됨 (thinking != off, 단일 tier 라우터에서는 무시).
  "routeEveryTurn": false,
  "classifierModels": [
    "@@typesafe/jev-latest",
    // @@agy/<model>[:<effort>] 항목은 agy(Google Antigravity CLI)로 분류함.
    // effort는 agy variant(high/medium/low)로 매핑됨 (생략 시 모델 기본 variant).
    // 모델 카탈로그는 ~/.cache/pi-agent-bridge/models.json 캐시를 참고함.
    // (model, effort)별 프로세스를 풀링하며 AGY_CLASSIFIER_IDLE_MS(기본 30분) idle 후 폐기.
    "@@agy/gemini-3.7-flash:high",
    "google/gemini-flash-latest#high",
    "google/gemini-flash-lite-latest#low",
  ],
  // @@typesafe/<model> 항목은 TypeSafe System One 분류기를 씀 (TYPESAFE_API_KEY 필요).
  // <model>은 API model 필드로 그대로 전달됨 (jev-latest, jev-1.13.0 등. `jev`는 400).
  // 체인 순서대로 시도하고 실패하면 다음 항목으로 폴백하므로 뒤에 LLM 모델/low tier를 두면 됨.
  "typesafeConfidenceThreshold": 0.5,
  "tierGuides": {
    "low": "Quick, cheap answers: one-paragraph summaries, commit messages, tiny edits.",
    "high": "Needs real design judgment: tradeoffs, planning, risky refactors in this repo.",
  },
  "routers": {
    "auto": {
      "high": {
        "models": [
          "openai/gpt-5.4-pro",
          "anthropic/claude-3-5-sonnet-20241022",
          "openai/gpt-4o#off",
        ],
        "effort": "high",
      },
      "medium": { "models": ["google/gemini-flash-latest"], "effort": "medium" },
      "low": { "models": ["openai/gpt-5.4-nano"], "effort": "low" },
    },
    "cheap": {
      "classifierModels": ["google/gemini-flash-lite-latest#low"],
      "high": { "models": ["google/gemini-flash-latest"], "effort": "low" },
      "medium": { "models": ["openai/gpt-5.4-nano"], "effort": "off" },
      "low": { "models": ["google/gemini-flash-lite-latest"], "effort": "off" },
    },
    "deep": {
      "classifierModels": ["openai/gpt-5.4-pro#low"],
      "high": { "models": ["openai/o1-preview"], "effort": "xhigh" },
      "medium": { "models": ["openai/gpt-5.4-pro"], "effort": "medium" },
      "low": { "models": ["google/gemini-flash-latest"], "effort": "low" },
    },
    "minimal": {
      "classifierModels": ["google/gemini-flash-latest"],
      "high": { "models": ["openai/gpt-5.4-pro"] },
      "medium": { "models": ["google/gemini-flash-latest"] },
      "low": { "models": ["openai/gpt-5.4-nano"], "effort": "off" },
    },
    "effort": {
      "models": ["openai/gpt-5.4-pro"],
      "high": { "effort": "high" },
      "medium": { "effort": "medium" },
      "low": { "effort": "low" },
    },
    "grok": {
      "classifierModels": ["xai/grok-composer-2.5"],
      "models": ["xai/grok-4.6", "commandcode/xai/grok-4.6", "opencode-go/grok-4.6"],
      "max": { "effort": "max" },
      "xhigh": { "effort": "xhigh" },
      "high": { "effort": "high" },
      "medium": { "effort": "medium" },
      "low": { "effort": "low" },
      "minimal": { "effort": "minimal" },
    },
    // 케이스 1: `@router#tier` — models 안에서 대상 tier의 모델을 실시간으로 펼침. 분류기는 정상 동작.
    "refTier": {
      // → xai/grok-4.6 (effort high, grok high tier의 모델 사용)
      "high": { "models": ["@grok#high"] },
      // → xai/grok-4.6 (effort medium)
      "medium": { "models": ["@grok#medium"] },
      // → xai/grok-4.6 (effort low)
      "low": { "models": ["@grok#low"] },
    },
    // 케이스 2: tier effort는 강제값 — 위임으로 펼친 모델과 모델별 `#effort`까지 덮어씀.
    "refEffort": {
      // → xai/grok-4.6#high (grok high tier 모델에 high 강제 지정)
      "high": { "models": ["@grok#high"], "effort": "high" },
      // → xai/grok-4.6#medium (grok medium tier 모델에 medium 강제 지정)
      "medium": { "models": ["@grok#medium#medium"] },
      // → xai/grok-4.6#off (grok low tier 모델에 off 강제 지정)
      "low": { "models": ["@grok#low#off"] },
    },
    // 케이스 3: 일반 모델과 위임을 섞을 수 있음. tier 생략 시 기본 티어(medium)로 위임하며
    // 위임 대상에서는 분류기를 다시 실행하지 않음.
    "refMixed": {
      "models": ["@grok", "@deepseek-flash#low", "openai/gpt-5.4-nano#low"],
      "high": {
        "models": ["@deepseek-flash#medium", "@grok", "openai/gpt-5.4-nano", "xai/grok-4.6#low"],
        "effort": "high",
      },
      "low": {
        "models": ["@deepseek-flash#low", "@grok", "openai/gpt-5.4-nano", "xai/grok-4.6#medium"],
      },
    },
    // 케이스 4: classifierModels ref — 분류기 후보 모델을 다른 라우터에서 가져옴.
    // 배열 항목 앞에 `@`를 붙임. 지정 tier 모델이 분류에 쓰임 (tier 생략 시 medium).
    // 일반 모델과 섞을 수도 있음: ["@grok#low#off", "openai/gpt-5.4-nano#low"]
    "refClassifier": {
      // 분류기 후보: xai/grok-4.6#off, commandcode/xai/grok-4.6#off, opencode-go/grok-4.6#off
      "classifierModels": ["@grok#low#off"],
      "high": { "models": ["@grok#high"] },
      "medium": { "models": ["@grok#medium"] },
      "low": { "models": ["@grok#low"] },
    },
  },
}

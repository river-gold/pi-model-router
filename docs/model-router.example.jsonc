{
  "debug": false,
  "historySize": 0,
  "classifierModels": ["google/gemini-flash-latest#high", "google/gemini-flash-lite-latest#low"],
  "tierGuides": {
    "low": "Quick, cheap answers: one-paragraph summaries, commit messages, tiny edits.",
    "high": "Needs real design judgment: tradeoffs, planning, risky refactors in this repo.",
  },
  "profiles": {
    "auto": {
      "high": {
        "models": [
          "openai/gpt-5.4-pro",
          "anthropic/claude-3-5-sonnet-20241022",
          "openai/gpt-4o#off",
        ],
        "effort": "high",
      },
      "medium": { "models": ["google/gemini-flash-latest"], "effort": "medium" },
      "low": { "models": ["openai/gpt-5.4-nano"], "effort": "low" },
    },
    "cheap": {
      "classifierModels": ["google/gemini-flash-lite-latest#low"],
      "high": { "models": ["google/gemini-flash-latest"], "effort": "low" },
      "medium": { "models": ["openai/gpt-5.4-nano"], "effort": "off" },
      "low": { "models": ["google/gemini-flash-lite-latest"], "effort": "off" },
    },
    "deep": {
      "classifierModels": ["openai/gpt-5.4-pro#low"],
      "high": { "models": ["openai/o1-preview"], "thinking": "xhigh" },
      "medium": { "models": ["openai/gpt-5.4-pro"], "thinking": "medium" },
      "low": { "models": ["google/gemini-flash-latest"], "thinking": "low" },
    },
    "minimal": {
      "classifierModels": ["google/gemini-flash-latest"],
      "high": { "models": ["openai/gpt-5.4-pro"] },
      "medium": { "models": ["google/gemini-flash-latest"] },
      "low": { "models": ["openai/gpt-5.4-nano"], "effort": "off" },
    },
    "effort": {
      "models": ["openai/gpt-5.4-pro"],
      "high": { "effort": "high" },
      "medium": { "effort": "medium" },
      "low": { "effort": "low" },
    },
    "grok": {
      "classifierModels": ["xai/grok-composer-2.5"],
      "models": ["xai/grok-4.6", "commandcode/xai/grok-4.6", "opencode-go/grok-4.6"],
      "max": { "effort": "max" },
      "xhigh": { "effort": "xhigh" },
      "high": { "effort": "high" },
      "medium": { "effort": "medium" },
      "low": { "effort": "low" },
      "minimal": { "effort": "minimal" },
    },
    // 케이스 1: profile#tier — 대상 tier의 모델과 effort를 그대로 사용. 분류기는 정상 동작.
    "refTier": {
      // → xai/grok-4.6 (effort high, grok high tier의 effort 사용)
      "high": { "ref": "grok#high" },
      // → xai/grok-4.6 (effort medium)
      "medium": { "ref": "grok#medium" },
      // → xai/grok-4.6 (effort low)
      "low": { "ref": "grok#low" },
    },
    // 케이스 2: profile##effort — 요청 tier를 따라가고 effort를 직접 지정.
    // 모델별 `#`와 tier effort는 무시됨. 기본 tier(medium) 자리에 있으면 분류기를 건너뜀.
    "refEffort": {
      // → xai/grok-4.6#high (grok high tier 모델에 high 강제 지정)
      "high": { "ref": "grok#high##high" },
      // → xai/grok-4.6#medium (분류기 스킵, medium 고정)
      "medium": { "ref": "grok##medium" },
      // → xai/grok-4.6#off (grok low tier 모델에 off 강제 지정)
      "low": { "ref": "grok##off" },
    },
    // 케이스 3: profile#tier##effort — 지정 tier의 모델에 effort를 직접 지정.
    // 요청 tier와 다른 tier를 가리킬 수 있음. 기본 tier(medium) 자리에 있으면 분류기를 건너뜀.
    "refTierEffort": {
      // → xai/grok-4.6#high (grok medium tier 모델에 high 강제 지정)
      "high": { "ref": "grok#medium##high" },
      // → xai/grok-4.6#medium (grok low tier 모델에 medium 강제 지정, 분류기 스킵)
      "medium": { "ref": "grok#low##medium" },
      // → xai/grok-4.6#off (grok medium tier 모델에 off 강제 지정)
      "low": { "ref": "grok#medium##off" },
    },
    // 케이스 4: classifierModels ref — 분류기 후보 모델을 다른 프로필에서 가져옴.
    // 배열 대신 { ref } 하나로 지정. low tier를 따라가므로 저비용 모델이 분류에 쓰임.
    "refClassifier": {
      // 분류기 후보: xai/grok-4.6#off, commandcode/xai/grok-4.6#off, opencode-go/grok-4.6#off
      "classifierModels": { "ref": "grok##off" },
      "high": { "ref": "grok#high" },
      "medium": { "ref": "grok#medium" },
      "low": { "ref": "grok#low" },
    },
  },
}

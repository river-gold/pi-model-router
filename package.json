{
  "name": "@river-gold/pi-model-router",
  "version": "0.4.4",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "!src/*.test.ts",
    "!index.test.ts",
    "LICENSE",
    "model-router.example.json",
    "README.md"
  ],
  "description": "Smart per-turn model router for Pi that optimizes your AI usage by dynamically switching LLM tiers based on task complexity and phase awareness.",
  "keywords": [
    "pi-package",
    "pi",
    "model-router",
    "llm",
    "coding-agent",
    "extension"
  ],
  "license": "MIT",
  "author": "river-gold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/river-gold/pi-model-router.git"
  },
  "homepage": "https://github.com/river-gold/pi-model-router#readme",
  "bugs": {
    "url": "https://github.com/river-gold/pi-model-router/issues"
  },
  "exports": {
    ".": "./index.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.4": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}

{
  "name": "@river-gold/pi-model-router",
  "version": "0.4.5",
  "description": "Smart per-turn model router for Pi that optimizes your AI usage by dynamically switching LLM tiers based on task complexity and phase awareness.",
  "keywords": [
    "coding-agent",
    "extension",
    "llm",
    "model-router",
    "pi",
    "pi-package"
  ],
  "homepage": "https://github.com/river-gold/pi-model-router#readme",
  "bugs": {
    "url": "https://github.com/river-gold/pi-model-router/issues"
  },
  "license": "MIT",
  "author": "river-gold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/river-gold/pi-model-router.git"
  },
  "files": [
    "package.json",
    "index.ts",
    "src",
    "!src/*.test.ts",
    "!index.test.ts",
    "LICENSE",
    "docs/model-router.example.jsonc",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "oxlint --format stylish",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.2.0",
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.4": true,
    "fsevents@2.3.3": true
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
